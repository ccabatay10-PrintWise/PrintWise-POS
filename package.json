{
  "name": "printwise-pos",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "electron:dev": "electron .",
    "electron:build": "npm run build && node electron/prepare.cjs && electron-builder --win --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "jszip": "^3.10.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "typescript": "5.8.2"
  },
  "build": {
    "asar": false,
    "appId": "com.printwise.pos",
    "productName": "PrintWise POS",
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "PrintWise-POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
